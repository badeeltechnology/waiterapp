<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/profile builds only: allow http to local test servers
     (the app itself still refuses http to public hosts). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
